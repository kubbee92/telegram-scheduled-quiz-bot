# Copy these into Ethiodeploy's environment variables. NEVER commit real values.
BOT_TOKEN=123456:token-from-BotFather
DATABASE_URL=postgresql://user:password@host/dbname?sslmode=require
CRON_SECRET=long-random-string-1
WEBHOOK_SECRET=long-random-string-2   # letters, digits, _ and - only
PUBLIC_URL=https://your-app.example.com
# Optional: more admins, comma separated (default is 5839558908)
# ADMIN_IDS=5839558908,111111111
